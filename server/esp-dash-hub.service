[Unit]
Description=ESP32 desk dashboard hub (GitHub Actions + server status, HTTPS :8443)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/esp-dash/dashd.py hub
Environment=HUB_NAME=aliyun-hub
Environment=SERVERS=aliyun-hub,gcp-isbf,aliyun-codex
Environment="SERVICES=feishu-bot=tcp:127.0.0.1:3000,docker=proc:dockerd,sshd=proc:sshd"
Environment=REPO=ISBF-Lab/ISBFweb
Environment=GITHUB_USER=Ginchanging
Environment=PORT=8443
LoadCredential=hub.pem:/etc/esp-dash/hub.pem
LoadCredential=hub.key:/etc/esp-dash/hub.key
LoadCredential=device_token:/etc/esp-dash/device_token
LoadCredential=agent_tokens.json:/etc/esp-dash/agent_tokens.json
# Mi Home via the local Home Assistant (server/homeassistant/); ha_token may be empty
LoadCredential=ha_token:/etc/esp-dash/ha_token
LoadCredential=mihome.json:/etc/esp-dash/mihome.json
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
# ledger.json (Kiki's diary counts) and scale.json (weight history) live in /var/lib/esp-dash
StateDirectory=esp-dash
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
